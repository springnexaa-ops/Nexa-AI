{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-ai",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "ai.springnexa.in/*", "zone_name": "springnexa.in" }
  ],
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "USER_STORE", "class_name": "UserStoreDO" },
      { "name": "MEDICAL_EVIDENCE", "class_name": "MedicalEvidenceDO" }
    ]
  },
  "exports": {
    "UserStoreDO": { "type": "durable-object", "storage": "sqlite" },
    "MedicalEvidenceDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
