{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-ai",
  "main": "src/medical-first-gateway.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "USER_STORE", "class_name": "UserStoreDO" },
      { "name": "MEDICAL_EVIDENCE", "class_name": "MedicalEvidenceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserStoreDO"] },
    { "tag": "v2", "new_sqlite_classes": ["MedicalEvidenceDO"] }
  ],
  "vars": {
    "AWS_REGION": "us-east-1",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-4-6"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
