{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NEXA Evaluation Result",
  "type":"object",
  "required":["evaluation_id","training_run_id","model_id","model_version","dataset_versions","metrics","safety_status","privacy_status","regression_status"],
  "properties":{
    "evaluation_id":{"type":"string","pattern":"^nexa-eval-[a-z0-9.-]+$"},
    "training_run_id":{"type":"string","pattern":"^nexa-run-[a-z0-9.-]+$"},
    "model_id":{"type":"string","pattern":"^nexa-[a-z0-9-]+$"},
    "model_version":{"type":"string","pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dataset_versions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "metrics":{"type":"array","minItems":1,"items":{"type":"object","required":["name","value","definition","denominator"],"properties":{"name":{"type":"string"},"value":{"type":"number"},"definition":{"type":"string","minLength":1},"denominator":{"type":"string","minLength":1}},"additionalProperties":false}},
    "safety_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "privacy_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "bias_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "regression_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "expert_review_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "artifact_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
