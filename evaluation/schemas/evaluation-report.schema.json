{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NEXA Evaluation Report",
  "type":"object",
  "required":["evaluation_id","model_id","dataset_versions","safety_status","metrics"],
  "properties":{
    "evaluation_id":{"type":"string"},
    "model_id":{"type":"string"},
    "dataset_versions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "safety_status":{"enum":["not_evaluated","pass","conditional","fail"]},
    "metrics":{"type":"object","minProperties":1},
    "expert_review":{"enum":["not_required","pending","completed"]},
    "privacy_review":{"enum":["pending","pass","fail"]},
    "bias_review":{"enum":["pending","pass","fail"]},
    "regression_status":{"enum":["pending","pass","fail"]}
  },
  "additionalProperties":false
}
