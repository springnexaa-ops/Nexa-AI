{
  "pipeline_id": "nexa-eeg-preprocessing-v0.1",
  "version": "0.1.0",
  "input": {"formats": ["edf", "edf+"], "require_de_identified": true, "require_sha256": true},
  "channel_policy": {"preserve_source_labels": true, "canonical_mapping_required": true, "allow_missing_channels": false},
  "preprocessing": {
    "filter": {"enabled": false, "low_hz": null, "high_hz": null},
    "notch": {"enabled": false, "frequency_hz": null},
    "resample_hz": null,
    "normalization": "configuration_required"
  },
  "epoching": {"window_seconds": 10, "overlap_seconds": 0, "label_alignment": "recording_relative_time"},
  "split": {
    "strategy": "subject_grouped",
    "ratios": {"train": 0.8, "validation": 0.1, "test": 0.1},
    "prevent_recording_leakage": true,
    "prevent_subject_leakage": true
  },
  "quality_control": {"reject_unreadable": true, "reject_structural_errors": true, "emit_rejection_manifest": true, "emit_dataset_fingerprint": true}
}
