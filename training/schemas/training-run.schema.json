{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NEXA Training Run",
  "type":"object",
  "required":["training_run_id","dataset_versions","code_commit","configuration","base_model","status"],
  "properties":{
    "training_run_id":{"type":"string","pattern":"^nexa-run-[a-z0-9.-]+$"},
    "dataset_versions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "code_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "configuration":{"type":"string"},
    "tokenizer":{"type":["string","null"]},
    "base_model":{"type":["string","null"]},
    "status":{"enum":["planned","running","completed","failed","rejected"]},
    "artifact_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
