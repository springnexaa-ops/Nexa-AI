{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springnexa.in/schemas/nexa-neuro-signal.json",
  "title": "Nexa NeuroSignal Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["modality", "samplingRateHz", "signal"],
  "properties": {
    "modality": { "enum": ["EEG", "EMG", "ECG"] },
    "samplingRateHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
    "signal": {
      "type": "array",
      "minItems": 16,
      "maxItems": 200000,
      "items": { "type": "number" }
    }
  }
}
